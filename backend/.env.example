# Inkloom AI - Backend Environment Configuration

# Required: Groq API Key for AI-powered compliance analysis and brand-aware rewriting
# Obtain from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Server Port (set automatically by Render via $PORT)
PORT=8000

# Optional: Allowed CORS Origins (comma-separated list of frontend domains)
# Example: https://inkloom-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app

# Optional: Custom SQLite database path (useful when attaching a persistent disk on Render)
# DATABASE_PATH=/var/data/inkloom.db

